# ===========================================
# El Palacio del Morfi - Variables de entorno
# ===========================================
# Copiá este archivo como .env y completá los valores.
# NUNCA subas el archivo .env al repositorio.

# Puerto del servidor
PORT=3000

# Cadena de conexión a MongoDB Atlas
# Formato: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/palacio_del_morfi?retryWrites=true&w=majority

# Entorno
NODE_ENV=development
